{
  "name": "Hermes Agent Dashboard",
  "short_name": "Hermes",
  "description": "Hermes Agent dashboard — sessions, config, and gateway controls",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#000000",
